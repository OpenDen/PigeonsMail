import { ScrollView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { NeuField, ToolButton } from "widgets.slint";

export struct ComposeAttachment {
    name: string,
    size: string,
    index: int,
}

// Floating compose window in the Gmail style. It sits over the mailbox without a backdrop and
// only holds the fields; the app owns sending, discarding, and formatting.
export component ComposeDialog inherits Rectangle {
    in-out property <string> to;
    in-out property <string> cc;
    in-out property <string> subject;
    in-out property <string> body;
    in property <string> from-address;
    in property <string> error;
    in property <image> preview-image;
    in-out property <bool> preview-mode: false;
    in property <[ComposeAttachment]> attachments;
    // Selection to restore after the app rewrites the body. Each change of `select-serial`
    // applies the selection, so repeating the same range still takes effect.
    in property <int> select-anchor;
    in property <int> select-cursor;
    in property <int> select-serial;
    callback send();
    callback discard();
    callback add-attachment();
    callback remove-attachment(int);
    callback format(string, int, int);
    callback preview();

    width: 560px;
    height: 600px;
    border-radius: 12px;
    background: Theme.surface;
    drop-shadow-blur: 24px;
    drop-shadow-offset-y: 6px;
    drop-shadow-color: Theme.shadow-dark;
    clip: true;

    changed select-serial => {
        editor.set-selection-offsets(root.select-anchor, root.select-cursor);
        editor.focus();
    }

    VerticalLayout {
        padding: 16px;
        spacing: 8px;

        HorizontalLayout {
            Text { text: "New message"; font-size: 15px; font-weight: 700; color: Theme.text; vertical-alignment: center; }
            Rectangle { }
            ToolButton { text: "×"; clicked => { root.discard(); } }
        }
        Text { text: "From " + root.from-address; font-size: 12px; color: Theme.text-dim; }
        NeuField { text <=> root.to; placeholder-text: "To"; }
        NeuField { text <=> root.cc; placeholder-text: "Cc"; }
        NeuField { text <=> root.subject; placeholder-text: "Subject"; }
        HorizontalLayout {
            spacing: 4px;
            ToolButton { text: "B"; clicked => { root.format("bold", editor.anchor-position-byte-offset, editor.cursor-position-byte-offset); } }
            ToolButton { text: "I"; clicked => { root.format("italic", editor.anchor-position-byte-offset, editor.cursor-position-byte-offset); } }
            ToolButton { text: "S"; clicked => { root.format("strike", editor.anchor-position-byte-offset, editor.cursor-position-byte-offset); } }
            ToolButton { text: "<>"; clicked => { root.format("code", editor.anchor-position-byte-offset, editor.cursor-position-byte-offset); } }
            ToolButton { text: "Link"; clicked => { root.format("link", editor.anchor-position-byte-offset, editor.cursor-position-byte-offset); } }
            ToolButton { text: "Quote"; clicked => { root.format("quote", editor.anchor-position-byte-offset, editor.cursor-position-byte-offset); } }
            ToolButton { text: "•"; clicked => { root.format("bullet", editor.anchor-position-byte-offset, editor.cursor-position-byte-offset); } }
            ToolButton { text: "1."; clicked => { root.format("numbered", editor.anchor-position-byte-offset, editor.cursor-position-byte-offset); } }
            Rectangle { }
            ToolButton {
                text: root.preview-mode ? "Edit" : "Preview";
                clicked => {
                    root.preview-mode = !root.preview-mode;
                    if root.preview-mode { root.preview(); }
                }
            }
        }
        Rectangle {
            vertical-stretch: 1;
            background: Theme.well;
            border-radius: 8px;
            clip: true;
            ScrollView {
                visible: !root.preview-mode;
                editor := TextInput {
                    text <=> root.body;
                    single-line: false;
                    wrap: word-wrap;
                    font-size: 13px;
                    color: Theme.text;
                    width: parent.width - 16px;
                    x: 8px;
                    y: 8px;
                }
            }
            if root.preview-mode: Rectangle {
                background: Theme.paper;
                Image {
                    source: root.preview-image;
                    width: parent.width;
                    height: parent.height;
                    image-fit: contain;
                }
            }
        }
        if root.attachments.length > 0: HorizontalLayout {
            spacing: 6px;
            for a in root.attachments: ToolButton {
                text: a.name + " (" + a.size + ") ×";
                clicked => { root.remove-attachment(a.index); }
            }
        }
        if root.error != "": Text {
            text: root.error;
            color: Theme.danger;
            font-size: 12px;
            wrap: word-wrap;
        }
        HorizontalLayout {
            spacing: 8px;
            ToolButton { text: "Send"; primary: true; clicked => { root.send(); } }
            ToolButton { text: "Attach"; clicked => { root.add-attachment(); } }
            Rectangle { }
        }
    }
}
