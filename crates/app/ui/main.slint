import { Button, ListView, Palette } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { AccentSwatch, Avatar, MailIcon, NeuCard, NeuChip, NeuField, NeuSelect, NeuSwitch, Tip, TitleIconButton, ToolButton } from "widgets.slint";
import { ComposeAttachment, ComposeDialog } from "compose.slint";
import { ManageDialog, ManageLabel, ManageRule } from "manage.slint";

export struct MessageItem {
    id: int,
    sender: string,
    subject: string,
    snippet: string,
    date: string,
    group: string,
    unread: bool,
    starred: bool,
    has-attachment: bool,
    initials: string,
    avatar: color,
}

// kind: 0 = unified inbox, 1 = account header, 2 = folder
export struct SidebarItem {
    kind: int,
    title: string,
    unread: int,
    folder-id: int,
    account-id: int,
    expanded: bool,
    icon: string,
}

export struct AttachmentChip {
    name: string,
    size: string,
    index: int,
}

export component MainWindow inherits Window {
    title: "PigeonMail";
    preferred-width: 1280px;
    preferred-height: 800px;
    min-width: 900px;
    min-height: 560px;
    background: Theme.background;

    // Sidebar
    in property <[SidebarItem]> sidebar;
    in-out property <int> selected-folder: -1;
    // Inbox selector: index 0 is the unified inbox, then one entry per account.
    in property <[string]> inbox-names;
    in property <[int]> inbox-ids;
    in-out property <int> inbox-index: 0;
    in-out property <bool> sidebar-open: true;
    callback select-folder(int);
    callback select-inbox(int);

    // Message list
    in property <[MessageItem]> messages;
    in property <int> selected-message: -1;
    in property <int> message-count: 0;
    in-out property <string> search-text;
    in-out property <bool> filter-unread;
    in-out property <bool> filter-starred;
    in-out property <bool> filter-attachments;
    callback select-message(int);
    callback close-reader();
    callback search-changed(string);
    callback filters-changed();

    // Reader
    in property <bool> has-message: false;
    in property <bool> loading: false;
    in property <string> reader-error;
    in property <string> msg-subject;
    in property <string> msg-from;
    in property <string> msg-inbox;
    in property <string> msg-initials;
    in property <color> msg-avatar;
    in property <string> msg-date;
    in property <string> msg-labels;
    in property <bool> msg-starred: false;
    in property <[AttachmentChip]> attachments;
    in property <string> reader-attachment;
    in property <image> body-image;
    in property <float> scroll-start: 0;
    in property <float> scroll-size: 1;
    in property <bool> body-link-hover: false;
    in property <int> remote-blocked: 0;
    in property <bool> remote-loading: false;
    in property <string> pending-link;
    callback viewport-resized(length, length);
    callback body-scrolled(length);
    callback body-clicked(length, length);
    callback body-pressed(length, length);
    callback body-dragged(length, length);
    callback copy-selection();
    callback body-hover(length, length);
    callback toggle-remote();
    callback open-link();
    callback dismiss-link();
    callback open-attachment(int);
    callback close-attachment();
    callback star();
    callback archive();
    callback delete-message();
    callback refresh();

    // Compose
    in-out property <bool> show-compose: false;
    in-out property <string> compose-to;
    in-out property <string> compose-cc;
    in-out property <string> compose-subject;
    in-out property <string> compose-body;
    in property <string> compose-from;
    in property <string> compose-error;
    in property <image> compose-preview-image;
    in-out property <bool> compose-preview-mode: false;
    in property <[ComposeAttachment]> compose-attachments;
    in property <int> compose-select-anchor;
    in property <int> compose-select-cursor;
    in property <int> compose-select-serial;
    callback compose-new();
    callback reply-message();
    callback reply-all-message();
    callback forward-message();
    callback compose-send();
    callback compose-discard();
    callback compose-add-attachment();
    callback compose-remove-attachment(int);
    callback compose-format(string, int, int);
    callback compose-preview();

    // Rules, labels, and connection settings
    in-out property <bool> show-manage: false;
    callback manage-open();
    in property <string> manage-account;
    in property <int> manage-account-id: -1;
    in property <string> manage-error;
    in property <[ManageRule]> manage-rules;
    in property <[ManageLabel]> manage-labels;
    in-out property <int> manage-mode: 0;
    in-out property <int> rule-id: -1;
    in-out property <string> rule-name;
    in-out property <string> rule-condition;
    in-out property <string> rule-actions;
    in-out property <bool> rule-enabled: true;
    in-out property <bool> rule-match-all: true;
    in property <string> rule-preview;
    in-out property <int> label-id: -1;
    in-out property <string> label-name;
    in-out property <string> manage-imap-host;
    in-out property <string> manage-smtp-host;
    in property <[string]> manage-accounts;
    in property <int> manage-account-index: -1;
    callback manage-select-account(int);
    callback select-rule(int);
    callback save-rule();
    callback delete-rule();
    callback dry-run-rules();
    callback select-label(int);
    callback create-label();
    callback rename-label();
    callback apply-label();
    callback delete-label();
    callback save-servers();
    callback close-manage();

    // Status and add-account dialog
    in property <string> status-text;
    in-out property <bool> show-add-account: false;
    in property <string> add-account-error;
    callback add-account(string, string, string, string, string);
    callback sign-in-google(string, string, string, string);
    callback sign-in-microsoft(string, string, string, string);
    callback email-edited(string);

    in-out property <bool> show-remove-account: false;
    in-out property <string> folder-tip;
    in-out property <length> folder-tip-y: 0px;
    in-out property <bool> folder-tip-active: false;
    in-out property <int> remove-account-id: -1;
    in-out property <string> remove-account-email;
    callback remove-account(int);

    in-out property <string> acc-email;
    in-out property <string> acc-password;
    in-out property <string> acc-imap-host;
    in-out property <string> acc-imap-port: "993";
    in-out property <string> acc-smtp-host;

    init => {
        Palette.color-scheme = Theme.dark ? ColorScheme.dark : ColorScheme.light;
        keys.focus();
    }

    keys := FocusScope {
        key-pressed(event) => {
            if (root.show-manage && event.text == Key.Escape) {
                root.close-manage();
                return accept;
            }
            if (root.show-add-account || root.show-remove-account || root.show-compose || root.show-manage) {
                return reject;
            }
            if (event.modifiers.control && (event.text == "c" || event.text == "\u{3}")) {
                root.copy-selection();
                return accept;
            }
            if (event.modifiers.control || event.modifiers.alt || event.modifiers.meta) {
                return reject;
            }
            if (event.text == "e") { root.archive(); return accept; }
            if (event.text == "#") { root.delete-message(); return accept; }
            if (event.text == "s") { root.star(); return accept; }
            if (event.text == "c") { root.compose-new(); return accept; }
            if (event.text == "r") { root.reply-message(); return accept; }
            if (event.text == "f") { root.forward-message(); return accept; }
            if (event.text == "/") { search.focus-input(); return accept; }
            reject
        }

        VerticalLayout {
            // ---------------- Top bar ----------------
            NeuCard {
                height: 48px;
                border-radius: 0px;
                drop-shadow-blur: 0px;
                drop-shadow-offset-x: 0px;
                drop-shadow-offset-y: 0px;

                VerticalLayout {
                    alignment: center;
                    HorizontalLayout {
                        padding-left: 14px;
                        padding-right: 10px;
                        spacing: 8px;
                        alignment: start;

                        Image {
                            source: @image-url("../../../Assets/PigeonMail.png");
                            width: 26px;
                            height: 26px;
                            image-fit: contain;
                        }
                        Text {
                            text: "PigeonMail";
                            font-size: 15px;
                            font-weight: 700;
                            color: Theme.text;
                            vertical-alignment: center;
                        }
                        TitleIconButton { icon: "menu"; tip: root.sidebar-open ? "Hide folders panel" : "Show folders panel"; clicked => { root.sidebar-open = !root.sidebar-open; } }
                        Rectangle { horizontal-stretch: 1; }
                        AccentSwatch { swatch: Theme.accent-palette[0]; selected: Theme.accent-index == 0; clicked => { Theme.accent-index = 0; } }
                        AccentSwatch { swatch: Theme.accent-palette[1]; selected: Theme.accent-index == 1; clicked => { Theme.accent-index = 1; } }
                        AccentSwatch { swatch: Theme.accent-palette[2]; selected: Theme.accent-index == 2; clicked => { Theme.accent-index = 2; } }
                        AccentSwatch { swatch: Theme.accent-palette[3]; selected: Theme.accent-index == 3; clicked => { Theme.accent-index = 3; } }
                        NeuSwitch {
                            checked: Theme.dark;
                            toggled => {
                                Theme.dark = !Theme.dark;
                                Palette.color-scheme = Theme.dark ? ColorScheme.dark : ColorScheme.light;
                            }
                        }
                        Rectangle { width: 6px; }
                        TitleIconButton { icon: "compose"; tip: "New message (c)"; clicked => { root.compose-new(); } }
                        TitleIconButton { icon: "settings"; tip: "Manage rules, labels and servers"; clicked => { root.manage-open(); keys.focus(); } }
                        TitleIconButton { icon: "sync"; tip: "Sync now"; clicked => { root.refresh(); } }
                        TitleIconButton { icon: "plus"; tip: "Connect another mail account"; clicked => { root.show-add-account = true; } }
                    }
                }

            }

            HorizontalLayout {
                spacing: 10px;
                padding: 10px;

                // ---------------- Sidebar ----------------
                sidebar-card := NeuCard {
                    width: root.sidebar-open ? 220px : 56px;

                    VerticalLayout {
                        padding: 10px;
                        spacing: 8px;

                        if root.sidebar-open: NeuSelect {
                            options: root.inbox-names;
                            current: root.inbox-index;
                            selected(i) => { keys.focus(); root.select-inbox(i); }
                        }
                        ListView {
                            for item in root.sidebar: row := Rectangle {
                                width: root.sidebar-open ? 176px : 36px;
                                height: 34px;
                                border-radius: 10px;
                                background: root.selected-folder == item.folder-id ? Theme.accent-soft : transparent;
                                border-width: root.selected-folder == item.folder-id ? 1.5px : 0px;
                                border-color: Theme.accent;

                                HorizontalLayout {
                                    padding-left: root.sidebar-open ? ((item.kind == 2 || item.kind == 3) ? 18px : 8px) : 10px;
                                    padding-right: root.sidebar-open ? 8px : 0px;
                                    spacing: 6px;
                                    Rectangle {
                                        width: 15px;
                                        MailIcon {
                                            name: item.icon;
                                            width: 15px;
                                            height: 15px;
                                            y: (parent.height - self.height) / 2;
                                            tint: root.selected-folder == item.folder-id ? Theme.accent : Theme.text-dim;
                                        }
                                    }
                                    if root.sidebar-open: Text {
                                        text: item.title;
                                        font-size: 13px;
                                        font-weight: item.kind == 0 ? 700 : 400;
                                        color: root.selected-folder == item.folder-id ? Theme.accent : Theme.text;
                                        vertical-alignment: center;
                                        overflow: elide;
                                    }
                                    if root.sidebar-open && item.unread > 0: Text {
                                        text: item.unread;
                                        font-size: 11px;
                                        color: Theme.accent;
                                        vertical-alignment: center;
                                        horizontal-alignment: right;
                                    }
                                }
                                area := TouchArea {
                                    changed has-hover => {
                                        root.folder-tip-active = self.has-hover;
                                        root.folder-tip = item.title;
                                        root.folder-tip-y = row.absolute-position.y;
                                    }
                                    clicked => {
                                        keys.focus();
                                        root.select-folder(item.folder-id);
                                    }
                                }
                            }
                        }

                        VerticalLayout {
                            spacing: 8px;

                            ToolButton { compact: !root.sidebar-open; text: "Calendar"; icon: "layout"; tip: "Calendar arrives in Phase 2"; enabled: false; }
                        }
                    }
                }

                // ---------------- Message list ----------------
                NeuCard {
                    width: 320px;

                    VerticalLayout {
                        padding: 10px;
                        spacing: 8px;

                        search := NeuField {
                            placeholder-text: "Search mail ( / )";
                            text <=> root.search-text;
                            edited(t) => { root.search-changed(t); }
                            accepted => { keys.focus(); }
                        }

                        HorizontalLayout {
                            spacing: 6px;
                            NeuChip {
                                text: "Unread";
                                active <=> root.filter-unread;
                                toggled => { keys.focus(); root.filters-changed(); }
                            }
                            NeuChip {
                                text: "Starred";
                                active <=> root.filter-starred;
                                toggled => { keys.focus(); root.filters-changed(); }
                            }
                            NeuChip {
                                text: "Attachments";
                                active <=> root.filter-attachments;
                                toggled => { keys.focus(); root.filters-changed(); }
                            }
                        }

                        ListView {
                            for m[i] in root.messages: VerticalLayout {
                                width: 288px;
                                spacing: 4px;
                                if i == 0 || root.messages[Math.max(i - 1, 0)].group != m.group: Text {
                                    text: m.group;
                                    font-size: 11px;
                                    font-weight: 600;
                                    color: Theme.accent;
                                    height: 22px;
                                    vertical-alignment: bottom;
                                }
                                Rectangle {
                                height: 72px;
                                border-radius: 10px;
                                // Full outline per row, disabled in favour of the top rule below.
                                // border-width: 1px;
                                // border-color: Theme.border;
                                background: root.selected-message == m.id ? Theme.well : transparent;

                                Rectangle {
                                    x: 0px;
                                    y: 0px;
                                    width: parent.width;
                                    height: 1px;
                                    background: Theme.border;
                                }

                                if root.selected-message == m.id: Rectangle {
                                    x: 0px;
                                    y: 12px;
                                    width: 3px;
                                    height: parent.height - 24px;
                                    border-radius: 2px;
                                    background: Theme.accent;
                                }

                                Avatar {
                                    x: 10px;
                                    y: 10px;
                                    initials: m.initials;
                                    tint: m.avatar;
                                }

                                VerticalLayout {
                                    padding: 8px;
                                    padding-left: 52px;
                                    padding-right: 14px;
                                    spacing: 2px;
                                    HorizontalLayout {
                                        spacing: 6px;
                                        if m.unread: Rectangle {
                                            width: 6px;
                                            height: 6px;
                                            y: 6px;
                                            border-radius: 3px;
                                            background: Theme.accent;
                                        }
                                        Text {
                                            text: m.sender;
                                            font-size: 13px;
                                            font-weight: m.unread ? 700 : 400;
                                            color: Theme.text;
                                            overflow: elide;
                                        }
                                        if m.has-attachment: Rectangle {
                                            width: 26px;
                                            height: 16px;
                                            y: 3px;
                                            border-radius: 8px;
                                            background: Theme.well;
                                            MailIcon {
                                                tint: Theme.text-dim;
                                            }
                                        }
                                        if m.starred: MailIcon {
                                            name: "star";
                                            width: 13px;
                                            height: 13px;
                                            y: 2px;
                                            tint: Theme.star;
                                        }
                                        Text {
                                            text: m.date;
                                            font-size: 11px;
                                            color: Theme.text-dim;
                                            horizontal-alignment: right;
                                            vertical-alignment: center;
                                        }
                                    }
                                    Text {
                                        text: m.subject;
                                        font-size: 13px;
                                        font-weight: m.unread ? 600 : 400;
                                        color: Theme.text;
                                        overflow: elide;
                                    }
                                    Text {
                                        text: m.snippet;
                                        font-size: 12px;
                                        color: Theme.text-dim;
                                        overflow: elide;
                                    }
                                }
                                TouchArea {
                                    clicked => {
                                        keys.focus();
                                        root.select-message(m.id);
                                    }
                                }
                            }
                            }
                        }
                    }
                }

                // ---------------- Reading pane ----------------
                NeuCard {
                    horizontal-stretch: 1;

                    if !root.has-message: Text {
                        text: root.message-count == 0 ? "No messages" : "Select a message to read";
                        color: Theme.text-dim;
                        font-size: 15px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    if root.has-message: VerticalLayout {
                        padding: 14px;
                        spacing: 12px;

                        HorizontalLayout {
                            spacing: 8px;
                            alignment: start;
                            ToolButton { text: "Reply"; icon: "reply"; tip: "Reply (r)"; clicked => { root.reply-message(); } }
                            ToolButton { text: "Reply all"; icon: "reply"; tip: "Reply to everyone"; clicked => { root.reply-all-message(); } }
                            ToolButton { text: "Forward"; icon: "forward"; tip: "Forward (f)"; clicked => { root.forward-message(); } }
                            Rectangle { width: 12px; }
                            ToolButton { text: "Archive"; icon: "archive"; tip: "Archive (e)"; clicked => { root.archive(); } }
                            ToolButton { text: "Delete"; icon: "trash"; tip: "Delete (#)"; clicked => { root.delete-message(); } }
                            ToolButton {
                                text: root.msg-starred ? "Unstar" : "Star";
                                icon: "star";
                                tip: root.msg-starred ? "Remove star (s)" : "Star (s)";
                                active: root.msg-starred;
                                clicked => { root.star(); }
                            }
                        }

                        Text {
                            text: root.msg-subject;
                            font-size: 20px;
                            font-weight: 700;
                            color: Theme.text;
                            wrap: word-wrap;
                        }
                        HorizontalLayout {
                            spacing: 10px;
                            alignment: start;
                            Rectangle {
                                width: 28px;
                                height: 28px;
                                border-radius: 14px;
                                background: back-area.has-hover ? Theme.well : transparent;
                                MailIcon {
                                    name: "arrow-left";
                                    width: 16px;
                                    height: 16px;
                                    x: 6px;
                                    y: 6px;
                                    tint: Theme.text-dim;
                                }
                                back-area := TouchArea {
                                    clicked => { root.close-reader(); }
                                }
                            }
                            Avatar {
                                initials: root.msg-initials;
                                tint: root.msg-avatar;
                            }
                            VerticalLayout {
                                spacing: 4px;
                                alignment: center;
                                Text {
                                    text: root.msg-from;
                                    font-size: 13px;
                                    font-weight: 700;
                                    color: Theme.text;
                                    overflow: elide;
                                }
                                Text {
                                    text: root.msg-inbox;
                                    font-size: 12px;
                                    color: Theme.text-dim;
                                    overflow: elide;
                                }
                            }
                        }
                        if root.msg-labels != "": Text {
                            text: "Labels: " + root.msg-labels;
                            font-size: 12px;
                            color: Theme.accent;
                            overflow: elide;
                        }
                        Text {
                            text: root.msg-date;
                            font-size: 12px;
                            color: Theme.text-dim;
                        }

                        if root.attachments.length > 0: HorizontalLayout {
                            spacing: 6px;
                            alignment: start;
                            for a in root.attachments: Rectangle {
                                height: 28px;
                                min-width: chip-label.preferred-width + 20px;
                                border-radius: 14px;
                                background: Theme.well;
                                chip-label := Text {
                                    text: a.name + "  (" + a.size + ")";
                                    font-size: 12px;
                                    color: Theme.text;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                                TouchArea {
                                    mouse-cursor: MouseCursor.pointer;
                                    clicked => { root.open-attachment(a.index); }
                                }
                            }
                        }

                        // Viewport canvas for the rendered message
                        if root.reader-attachment != "": HorizontalLayout {
                            spacing: 8px;
                            Text {
                                text: "Markdown: " + root.reader-attachment;
                                font-size: 12px;
                                color: Theme.text-dim;
                                vertical-alignment: center;
                            }
                            Rectangle { }
                            ToolButton { text: "Back to message"; clicked => { root.close-attachment(); } }
                        }
                        Rectangle {
                            vertical-stretch: 1;
                            background: Theme.paper;
                            border-radius: 8px;
                            clip: true;

                            changed width => { root.viewport-resized(self.width, self.height); }
                            changed height => { root.viewport-resized(self.width, self.height); }

                            Image {
                                width: parent.width;
                                height: parent.height;
                                source: root.body-image;
                                image-fit: fill;
                            }

                            if root.loading: Text {
                                text: "Downloading message...";
                                color: Theme.text-dim;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                            if root.reader-error != "": Text {
                                text: root.reader-error;
                                color: Theme.danger;
                                wrap: word-wrap;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }

                            // Scroll indicator
                            if root.scroll-size < 1: Rectangle {
                                x: parent.width - 6px;
                                y: root.scroll-start * parent.height;
                                width: 4px;
                                height: root.scroll-size * parent.height;
                                border-radius: 2px;
                                background: Theme.shadow-dark;
                            }

                            TouchArea {
                                mouse-cursor: root.body-link-hover ? MouseCursor.pointer : MouseCursor.default;
                                scroll-event(e) => {
                                    root.body-scrolled(e.delta-y);
                                    accept
                                }
                                pointer-event(e) => {
                                    if (e.kind == PointerEventKind.move) {
                                        root.body-hover(self.mouse-x, self.mouse-y);
                                        if (self.pressed) {
                                            root.body-dragged(self.mouse-x, self.mouse-y);
                                        }
                                    } else if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) {
                                        keys.focus();
                                        root.body-pressed(self.mouse-x, self.mouse-y);
                                    }
                                }
                                clicked => {
                                    keys.focus();
                                    root.body-clicked(self.mouse-x, self.mouse-y);
                                }
                            }

                            // Overlays sit on top of the canvas so showing them never resizes it.
                            if root.pending-link != "": Rectangle {
                                y: 0px;
                                height: 40px;
                                background: Theme.accent-soft;
                                HorizontalLayout {
                                    padding-left: 10px;
                                    padding-right: 10px;
                                    spacing: 10px;
                                    alignment: start;
                                    Text {
                                        text: "Open " + root.pending-link + " ?";
                                        font-size: 12px;
                                        color: Theme.text;
                                        vertical-alignment: center;
                                        overflow: elide;
                                    }
                                    ToolButton { text: "Open"; y: 4px; clicked => { root.open-link(); } }
                                    ToolButton { text: "Cancel"; y: 4px; clicked => { root.dismiss-link(); } }
                                }
                            }

                            if root.remote-blocked > 0: Rectangle {
                                y: parent.height - self.height;
                                height: 40px;
                                background: Theme.notice;
                                HorizontalLayout {
                                    padding-left: 10px;
                                    padding-right: 10px;
                                    spacing: 10px;
                                    alignment: start;
                                    Text {
                                        text: root.remote-blocked + " remote image(s) blocked to protect your privacy";
                                        font-size: 12px;
                                        color: Theme.text;
                                        vertical-alignment: center;
                                    }
                                    ToolButton {
                                        text: root.remote-loading ? "Loading..." : "Load remote images";
                                        enabled: !root.remote-loading;
                                        y: 4px;
                                        clicked => { root.toggle-remote(); }
                                    }
                                }
                            }
                        }
                    }
                }
            }

            // ---------------- Status bar ----------------
            Rectangle {
                height: 26px;
                background: Theme.well;
                HorizontalLayout {
                    padding-left: 14px;
                    padding-right: 14px;
                    Text {
                        text: root.status-text;
                        font-size: 12px;
                        color: Theme.text-dim;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                }
            }
        }
    }

    // Collapsed-sidebar label tooltip. One popup at window level, since popups cannot be repeated.
    Tip {
        x: sidebar-card.absolute-position.x + sidebar-card.width + 8px;
        y: root.folder-tip-y + 5px;
        text: root.folder-tip;
        active: root.folder-tip-active && !root.sidebar-open;
    }

    // ---------------- Compose dialog ----------------
    if root.show-compose: ComposeDialog {
        x: root.width - self.width - 24px;
        y: root.height - self.height - 24px;
        to <=> root.compose-to;
        cc <=> root.compose-cc;
        subject <=> root.compose-subject;
        body <=> root.compose-body;
        from-address: root.compose-from;
        error: root.compose-error;
        preview-image: root.compose-preview-image;
        preview-mode: root.compose-preview-mode;
        attachments: root.compose-attachments;
        select-anchor: root.compose-select-anchor;
        select-cursor: root.compose-select-cursor;
        select-serial: root.compose-select-serial;
        send => { root.compose-send(); }
        discard => { root.compose-discard(); keys.focus(); }
        add-attachment => { root.compose-add-attachment(); }
        remove-attachment(index) => { root.compose-remove-attachment(index); }
        format(format, anchor, cursor) => { root.compose-format(format, anchor, cursor); }
        preview => { root.compose-preview(); }
    }

    // ---------------- Rules, labels and server settings ----------------
    if root.show-manage: ManageDialog {
        account-email: root.manage-account;
        account-options: root.manage-accounts;
        account-index: root.manage-account-index;
        error: root.manage-error;
        rules: root.manage-rules;
        labels: root.manage-labels;
        mode <=> root.manage-mode;
        rule-id <=> root.rule-id;
        rule-name <=> root.rule-name;
        rule-condition <=> root.rule-condition;
        rule-actions <=> root.rule-actions;
        rule-enabled <=> root.rule-enabled;
        rule-match-all <=> root.rule-match-all;
        rule-preview: root.rule-preview;
        label-id <=> root.label-id;
        label-name <=> root.label-name;
        imap-host <=> root.manage-imap-host;
        smtp-host <=> root.manage-smtp-host;
        close => { root.close-manage(); keys.focus(); }
        select-account(index) => { root.manage-select-account(index); }
        select-rule(id) => { root.select-rule(id); }
        save-rule => { root.save-rule(); }
        delete-rule => { root.delete-rule(); }
        dry-run => { root.dry-run-rules(); }
        select-label(id) => { root.select-label(id); }
        create-label => { root.create-label(); }
        rename-label => { root.rename-label(); }
        apply-label => { root.apply-label(); }
        delete-label => { root.delete-label(); }
        save-servers => { root.save-servers(); }
        remove-account => {
            root.remove-account-id = root.manage-account-id;
            root.remove-account-email = root.manage-account;
            root.show-remove-account = true;
        }
    }

    // ---------------- Remove account confirmation (above Manage) ----------------
    if root.show-remove-account: Rectangle {
        background: Theme.scrim;
        TouchArea { }

        Rectangle {
            width: 380px;
            height: 200px;
            border-radius: 14px;
            background: Theme.surface;

            VerticalLayout {
                padding: 20px;
                spacing: 10px;

                Text { text: "Remove account?"; font-size: 18px; font-weight: 700; color: Theme.text; }
                Text {
                    text: "\{root.remove-account-email} and its synced mail will be deleted from this device. Mail on the server is not affected.";
                    font-size: 12px;
                    color: Theme.text-dim;
                    wrap: word-wrap;
                }
                Rectangle { vertical-stretch: 1; }
                HorizontalLayout {
                    spacing: 8px;
                    alignment: end;
                    ToolButton {
                        text: "Cancel";
                        clicked => { root.show-remove-account = false; keys.focus(); }
                    }
                    ToolButton {
                        text: "Remove";
                        danger: true;
                        clicked => {
                            root.show-remove-account = false;
                            root.remove-account(root.remove-account-id);
                            keys.focus();
                        }
                    }
                }
            }
        }
    }

    // ---------------- Add account dialog ----------------
    if root.show-add-account: Rectangle {
        background: Theme.scrim;
        TouchArea { }

        Rectangle {
            width: 420px;
            height: 540px;
            border-radius: 14px;
            background: Theme.surface;
            drop-shadow-blur: 24px;
            drop-shadow-color: Theme.shadow-dark;
            drop-shadow-offset-y: 8px;

            VerticalLayout {
                padding: 20px;
                spacing: 8px;

                Text { text: "Add mail account"; font-size: 18px; font-weight: 700; color: Theme.text; }
                Text {
                    text: "Sign in with your provider (recommended), or use an app password for IMAP. Passwords are kept in the OS keyring.";
                    font-size: 12px;
                    color: Theme.text-dim;
                    wrap: word-wrap;
                }
                Text { text: "Email address"; font-size: 12px; color: Theme.text-dim; }
                NeuField {
                    text <=> root.acc-email;
                    placeholder-text: "you@example.com";
                    edited(t) => { root.email-edited(t); }
                }
                HorizontalLayout {
                    spacing: 8px;
                    ToolButton {
                        text: "Sign in with Google";
                        clicked => {
                            root.sign-in-google(root.acc-email, root.acc-imap-host, root.acc-imap-port, root.acc-smtp-host);
                        }
                    }
                    ToolButton {
                        text: "Sign in with Microsoft";
                        clicked => {
                            root.sign-in-microsoft(root.acc-email, root.acc-imap-host, root.acc-imap-port, root.acc-smtp-host);
                        }
                    }
                }
                Text { text: "App password (for other providers)"; font-size: 12px; color: Theme.text-dim; }
                NeuField { text <=> root.acc-password; password: true; }
                Text { text: "IMAP server (blank = guess from address)"; font-size: 12px; color: Theme.text-dim; }
                HorizontalLayout {
                    spacing: 8px;
                    NeuField { text <=> root.acc-imap-host; placeholder-text: "auto from email address"; }
                    NeuField { text <=> root.acc-imap-port; width: 70px; }
                }
                Text { text: "SMTP server (blank = guess from address)"; font-size: 12px; color: Theme.text-dim; }
                NeuField { text <=> root.acc-smtp-host; placeholder-text: "auto from email address"; }
                if root.add-account-error != "": Text {
                    text: root.add-account-error;
                    color: Theme.danger;
                    font-size: 12px;
                    wrap: word-wrap;
                }
                HorizontalLayout {
                    spacing: 8px;
                    alignment: end;
                    ToolButton {
                        text: "Cancel";
                        clicked => { root.show-add-account = false; keys.focus(); }
                    }
                    ToolButton {
                        text: "Add";
                        clicked => {
                            root.add-account(root.acc-email, root.acc-password, root.acc-imap-host,
                                root.acc-imap-port, root.acc-smtp-host);
                        }
                    }
                }
            }
        }
    }
}
