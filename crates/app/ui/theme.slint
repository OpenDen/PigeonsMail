// Neumorphic palette shared by every view.
// `dark` switches the base palette; `accent-index` picks the neon colour and works in both modes.
// Background and surface share one base colour so raised and inset elements sit on the same plane.
export global Theme {
    in-out property <bool> dark: false;
    // 0 = cyan, 1 = violet, 2 = magenta, 3 = green
    in-out property <int> accent-index: 0;

    // Window base, raised cards, inset field fill and hairline borders.
    out property <color> background: dark ? #0f131b : #f4f6fb;
    out property <color> surface: dark ? #181d28 : #ffffff;
    out property <color> well: dark ? #10141d : #f1f4f9;
    out property <color> border: dark ? #2a3142 : #d5dce8;
    out property <color> paper: dark ? #1d2330 : #ffffff;
    out property <color> shadow-light: dark ? #2b3246 : #ffffff;
    out property <color> shadow-dark: dark ? #05070b : #cfd6e3;
    out property <color> scrim: #0b0e1599;
    out property <color> text: dark ? #e8ecf4 : #1a2130;
    out property <color> text-dim: dark ? #8d97aa : #667085;

    out property <color> accent: accent-palette[accent-index];
    // Neon choices offered in the sidebar: cyan, violet, magenta, green.
    out property <[color]> accent-palette: [#00e0ff, #a77bff, #ff4fb0, #3dff9a];
    out property <color> accent-glow: accent.transparentize(dark ? 0.45 : 0.6);
    out property <color> accent-soft: accent.transparentize(dark ? 0.85 : 0.8);
    // Text placed on top of a neon fill.
    out property <color> accent-ink: #0b1020;

    out property <color> danger: #ff5c7a;
    out property <color> star: #ffc23d;
    out property <color> notice: dark ? #3a3320 : #f5ecd0;
    out property <length> radius-card: 18px;
    out property <length> radius-control: 12px;
}
