// Neumorphic palette shared by every view. Light-only.
export global Theme {
    out property <color> background: #e4e9f0;
    out property <color> surface: #eef2f7;
    out property <color> shadow-dark: #b8c0cc;
    out property <color> text: #2b3340;
    out property <color> text-dim: #6b7585;
    out property <color> accent: #3b7ddd;
    out property <color> accent-soft: #d6e4fa;
    out property <color> danger: #c0392b;
    out property <color> star: #e0a800;
}
